/**
 * Minimal core test for the statistics module to verify the C++ test pipeline.
 * This test exercises basic DataProvider functionality without complex dependencies.
 */

#include <cxxtest/TestSuite.h>

#include <opencog/learning/statistics/DataProvider.h>
#include <opencog/learning/statistics/Probability.h>
#include <opencog/util/Logger.h>

using namespace std;
using namespace opencog;
using namespace statistics;

class StatisticsCoreTestSuite : public CxxTest::TestSuite
{
public:
    void test_basic_data_provider_operations()
    {
        // Test basic DataProvider construction and operations
        const int N_GRAMS = 2;
        const bool ORDERED = false;
        DataProvider<std::string> provider(N_GRAMS, ORDERED);

        // Test adding metadata
        bool is_first = provider.addOneMetaData("test_token_1");
        TS_ASSERT(is_first);

        // Test duplicate metadata
        is_first = provider.addOneMetaData("test_token_1");
        TS_ASSERT(!is_first);

        // Test adding multiple tokens
        provider.addOneMetaData("test_token_2");
        provider.addOneMetaData("test_token_3");
        TS_ASSERT_EQUALS(provider.mDataSet->size(), 3);

        // Test adding raw data counts
        vector<std::string> bigram = {"test_token_1", "test_token_2"};
        provider.addOneRawDataCount(bigram, 5);

        // Test key generation
        vector<std::string> tokens = {"test_token_1", "test_token_2", "test_token_3"};
        std::vector<long> key_vector = provider.makeKeyFromData(tokens);
        TS_ASSERT_EQUALS(key_vector.size(), 3);

        // Test data reconstruction from key
        std::vector<std::string> value_vector = provider.makeDataFromKey(key_vector);
        TS_ASSERT_EQUALS(value_vector.size(), 3);
    }

    void test_probability_calculation()
    {
        // Test probability calculation with simple data
        const int N_GRAMS = 2;
        const bool ORDERED = false;
        DataProvider<std::string> provider(N_GRAMS, ORDERED);

        // Add tokens
        provider.addOneMetaData("a");
        provider.addOneMetaData("b");
        provider.addOneMetaData("c");

        // Add counts
        vector<std::string> ab = {"a", "b"};
        vector<std::string> ac = {"a", "c"};
        provider.addOneRawDataCount(ab, 2);
        provider.addOneRawDataCount(ac, 1);

        // Calculate probabilities
        Probability::calculateProbabilities(provider);

        // Verify probabilities
        std::map<std::vector<long>, StatisticData>::iterator it;
        const std::vector<long> ab_index = {0, 1};
        it = provider.mDataMaps[2].find(ab_index);
        TS_ASSERT(it != provider.mDataMaps[2].end());
        TS_ASSERT_DELTA(it->second.probability, 0.666, 0.01);

        const std::vector<long> ac_index = {0, 2};
        it = provider.mDataMaps[2].find(ac_index);
        TS_ASSERT(it != provider.mDataMaps[2].end());
        TS_ASSERT_DELTA(it->second.probability, 0.333, 0.01);
    }

    void test_empty_provider()
    {
        // Test that an empty provider handles edge cases gracefully
        const int N_GRAMS = 2;
        const bool ORDERED = false;
        DataProvider<std::string> provider(N_GRAMS, ORDERED);

        // Empty provider should have size 0
        TS_ASSERT_EQUALS(provider.mDataSet->size(), 0);

        // Probability calculation on empty provider should not crash
        Probability::calculateProbabilities(provider);
        TS_ASSERT_EQUALS(provider.mDataMaps[2].size(), 0);
    }
};
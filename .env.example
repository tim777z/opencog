# ---------------------------------------------------------------------------
# OpenCog environment template
#
#   cp .env.example .env
#
# .env is gitignored. NEVER commit a real .env: it holds credentials.
# Every variable below is optional; the defaults shown are the secure ones
# (loopback bind, no wildcard CORS, bounded request sizes) and are what the
# code uses when the variable is unset.
#
# The cogserver reads its own configuration from lib/opencog.conf; only the
# Python-layer components (the REST API and the CSV dataset loader) read the
# variables in this file.
# ---------------------------------------------------------------------------

# === OpenCog REST API =====================================================
# The REST API exposes /api/v1.1/shell and /api/v1.1/scheme, both of which
# execute code inside the cogserver process. Treat this service as
# equivalent to a remote shell.

# Bearer token required on every /api/v1.1 request.
#   * Leave EMPTY only for a loopback bind with no untrusted local users.
#   * Set it to a long random string before exposing the service at all.
#   * The server REFUSES to start on a non-loopback interface with this
#     unset -- see assert_safe_bind() in opencog/python/web/api/apisecurity.py.
#   * Generate one with:  openssl rand -hex 32
OPENCOG_API_TOKEN=

# Comma-separated origins allowed to read responses cross-origin.
#   * Do not set this to '*'. The API is normally reached from the local
#     machine, and a wildcard turns it into a cross-site data-exfiltration
#     primitive for any page the user visits.
#   * Set to an empty value to deny every cross-origin read.
OPENCOG_API_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Flask session signing key. Only needed if sessions/messages are enabled;
# sourced from the environment rather than baked into the image.
OPENCOG_API_SECRET_KEY=

# Listen address. Do not change to 0.0.0.0 unless OPENCOG_API_TOKEN is set.
OPENCOG_API_BIND_HOST=127.0.0.1
OPENCOG_API_BIND_PORT=5000

# === Request bounds =======================================================
# These bound memory and CPU consumed by unauthenticated or buggy clients.
OPENCOG_API_MAX_CONTENT_LENGTH=1048576     # 1 MiB request body
OPENCOG_API_MAX_COMMAND_LENGTH=8192        # cogserver / Scheme command chars
OPENCOG_API_MAX_LIMIT=10000                # hard cap on ?limit=
OPENCOG_API_DEFAULT_LIMIT=100              # page size when ?limit= is absent

# === CSV dataset loader ===================================================
# opencog/python/utility/csv_dataset_parser.py only fetches http(s) URLs and
# refuses loopback, link-local and cloud-metadata hosts. It caps the response
# at 64 MiB and times out after 30 s; both are module constants rather than
# settings because they are security controls, not tuning knobs.
CSV_ALLOWED_URL_SCHEMES=http,https

# === Logging ==============================================================
# Log levels: DEBUG, INFO, WARNING, ERROR. cogserver accepts
#   cogserver -c <config-file>   and the cogserver.conf log level lives in
# lib/opencog.conf.
OPENCOG_LOG_LEVEL=INFO
